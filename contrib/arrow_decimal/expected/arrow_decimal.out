CREATE TABLE invalid_decimal128 (v decimal128(39,0));
ERROR:  DECIMAL128 precision 39 must be between 1 and 38
LINE 1: CREATE TABLE invalid_decimal128 (v decimal128(39,0));
                                           ^
CREATE TABLE invalid_decimal64_scale (v decimal64(18,19));
ERROR:  DECIMAL64 scale 19 must be between -18 and 18
LINE 1: CREATE TABLE invalid_decimal64_scale (v decimal64(18,19));
                                                ^
DROP EXTENSION arrow_decimal CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to column d64 of table arrow_decimal_test
drop cascades to column d128 of table arrow_decimal_test
